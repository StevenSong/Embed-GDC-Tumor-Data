name: "virchow"
platform: "pytorch_libtorch"
max_batch_size: 2048
input [
  {
    name: "INPUT__0"
    data_type: TYPE_UINT8
    dims: [3,224,224]
  }
]
output [
  {
    name: "OUTPUT__0"
    data_type: TYPE_FP32
    dims: [2560]
  }
]

instance_group [
    {
        count: 1
        kind: KIND_GPU
    }
]
